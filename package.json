{
  "name": "control-tower",
  "productName": "Control Tower",
  "version": "0.1.0",
  "description": "A desktop dashboard for in-flight Claude Code sessions",
  "main": "./out/main/index.js",
  "author": "Sean Neden",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --mac --dir && npm run package:sign",
    "package:sign": "codesign --force --deep --sign - dist/mac*/*.app && codesign --verify --deep --strict dist/mac*/*.app",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "chokidar": "^5.0.0",
    "electron-store": "^11.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "lucide-react": "^0.552.0",
    "prettier": "^3.7.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.7",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.cannuk.control-tower",
    "productName": "Control Tower",
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "linux": {
      "icon": "resources/icon.png"
    },
    "win": {
      "icon": "resources/icon.png"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  }
}
